datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String?
  role      String   // 'customer' (tenant), 'owner', 'admin'
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  ownedProperties Property[] @relation("OwnerToProperty")
  rentedProperty  Property?  @relation("TenantToProperty", fields: [propertyId], references: [id])
  propertyId      String?    @unique

  documents   TenantDocument[]
  maintenance TenantMaintenance[]
  electricity TenantElectricity[]
  payments    TenantPayment[]
  agreement   TenantAgreement?
  bookingRequests BookingRequest[] @relation("CustomerToBooking")
  visitors    Visitor[]

  savedProperties String?
  checklistTenant String?
  checklistOwner  String?
  splitRent       String?
}

model Property {
  id              String   @id @default(uuid())
  title           String
  image           String
  price           String
  location        String
  beds            Int
  baths           Int
  type            String   // e.g., 'House', 'Apartment'
  capacity        Int?
  status          String   @default("Available") // 'Available', 'Reserved', 'Occupied'
  deposit         String   @default("₹10,000")
  maintenance     String   @default("₹1,000")
  availableFrom   String?
  furnishedStatus String?  // 'Fully Furnished', 'Semi-Furnished', 'Unfurnished'
  parking         Boolean  @default(false)
  petFriendly     Boolean  @default(false)
  suitability     String?  // 'Family', 'Bachelor', 'Any'
  latitude        Float?
  longitude       Float?
  videos          String?  // comma-separated urls
  floorPlan       String?
  amenities       String?  // comma-separated values
  
  ownerId    String?
  owner      User?    @relation("OwnerToProperty", fields: [ownerId], references: [id])
  
  tenant     User?    @relation("TenantToProperty")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  bookingRequests BookingRequest[]
  inventory       InventoryItem[]

  houseRules          String?
  nearbyPlaces        String?
  safetyCctv          Boolean @default(false)
  safetySecurityGuard Boolean @default(false)
  safetyGated         Boolean @default(false)
  safetyFire          Boolean @default(false)
  safetyLighting      Boolean @default(false)
  responseTime        String? @default("Replies within 10 minutes")
  visitDate           String?
  visitTime           String?
}

model TenantDocument {
  id        String   @id @default(uuid())
  name      String
  status    String   // 'Verified' | 'Pending' | 'Rejected'
  date      String
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
}

model TenantMaintenance {
  id              String   @id @default(uuid())
  type            String
  status          String   // 'Open' | 'Assigned' | 'In Progress' | 'Resolved' | 'Closed'
  date            String
  description     String
  servicePerson   String?
  resolutionNotes String?
  tenantId        String
  tenant          User     @relation(fields: [tenantId], references: [id])
  photo           String?
}

model TenantElectricity {
  id        String   @id @default(uuid())
  month     String
  amount    String
  status    String   // 'Paid' | 'Unpaid'
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
}

model TenantPayment {
  id        String   @id @default(uuid())
  date      String
  amount    String
  type      String   // 'Rent' | 'Deposit' | 'Maintenance'
  status    String   @default("Paid") // 'Paid' | 'Unpaid'
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
}

model TenantAgreement {
  id              String   @id @default(uuid())
  renewalDate     String
  signedDate      String
  status          String
  ownerSignature  String?
  tenantSignature String?
  terms           String?
  duration        Int?     // months
  rent            String?
  deposit         String?
  tenantId        String   @unique
  tenant          User     @relation(fields: [tenantId], references: [id])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  role      String   // 'customer' | 'owner' | 'admin'
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  text       String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
}

model BookingRequest {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  customerId String
  customer   User     @relation("CustomerToBooking", fields: [customerId], references: [id])
  status     String   // 'Pending', 'Approved', 'Rejected', 'Completed'
  visitDate  String?
  createdAt  DateTime @default(now())
}

model Visitor {
  id        String    @id @default(uuid())
  name      String
  phone     String
  qrCode    String
  status    String    @default("Invited") // 'Invited', 'Entered', 'Exited'
  entryTime DateTime?
  exitTime  DateTime?
  tenantId  String
  tenant    User      @relation(fields: [tenantId], references: [id])
}

model InventoryItem {
  id                  String   @id @default(uuid())
  name                String
  status              String   @default("Good") // 'Good', 'Damaged', 'Missing'
  acknowledgedByTenant Boolean  @default(false)
  acknowledgedByOwner  Boolean  @default(false)
  image               String?
  propertyId          String
  property            Property @relation(fields: [propertyId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  authorId   String
  targetId   String
  targetType String   // 'Property', 'User'
  createdAt  DateTime @default(now())

  cleanliness        Int @default(5)
  location           Int @default(5)
  safety             Int @default(5)
  valueForMoney      Int @default(5)
  ownerCommunication Int @default(5)
}
